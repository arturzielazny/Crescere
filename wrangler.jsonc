{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crescere",
  "main": "worker/index.js",
  "compatibility_date": "2026-10-01",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "crescere",
      "database_id": "42aa96c1-30db-4f8a-97e0-124c4209a8a0",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      // Sign-in, account claim, password change and guest creation, per client IP
      "name": "AUTH_LIMITER",
      "namespace_id": "1001",
      "simple": { "limit": 10, "period": 60 }
    }
  ],
  "vars": {
    // PBKDF2 iterations for new password hashes (max 100000). Lower this if sign-in
    // fails with error 1102 (CPU limit exceeded) on the Workers Free plan.
    "PASSWORD_ITERATIONS": "100000"
  },
  "triggers": {
    // Daily cleanup of expired sessions and abandoned guest accounts
    "crons": ["17 3 * * *"]
  },
  "observability": { "enabled": true }
}
