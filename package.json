{
  "name": "crescere",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run db:migrate:local && vite",
    "build": "vite build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && npm run db:migrate:remote && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply crescere --local",
    "db:migrate:remote": "wrangler d1 migrations apply crescere --remote",
    "test": "vitest run --exclude 'worker/**' && npm run test:worker",
    "test:watch": "vitest --exclude 'worker/**'",
    "test:worker": "vitest run --config vitest.worker.config.js",
    "lint": "eslint src/ worker/ scripts/",
    "lint:fix": "eslint src/ worker/ scripts/ --fix",
    "format": "prettier --write src/ worker/",
    "format:check": "prettier --check src/ worker/",
    "prepare": "husky",
    "analyze": "node scripts/analyze.js",
    "analyze:open": "node scripts/analyze.js --open",
    "analyze:coverage": "vitest run --exclude 'worker/**' --coverage",
    "analyze:bundle": "ANALYZE=true vite build",
    "analyze:duplication": "jscpd src/",
    "analyze:deps": "madge --circular --extensions js src/ && knip",
    "analyze:lighthouse": "node scripts/lighthouse.js",
    "analyze:lighthouse:open": "node scripts/lighthouse.js --open"
  },
  "lint-staged": {
    "*.{js,svelte}": [
      "eslint --fix --no-warn-ignored",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.65.0",
    "@cloudflare/vitest-plugin": "^1.4.7",
    "@eslint/js": "^9.39.2",
    "@sveltejs/vite-plugin-svelte": "^6.2.1",
    "@tailwindcss/vite": "^4.1.18",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.2",
    "eslint-plugin-sonarjs": "^3.0.6",
    "eslint-plugin-svelte": "^3.14.0",
    "husky": "^9.1.7",
    "jscpd": "^4.0.8",
    "knip": "^5.83.0",
    "lint-staged": "^16.2.7",
    "madge": "^8.0.0",
    "prettier": "^3.8.1",
    "prettier-plugin-svelte": "^3.4.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "svelte": "^5.43.8",
    "tailwindcss": "^4.1.18",
    "vite": "^7.2.4",
    "vitest": "^4.1.12",
    "wrangler": "^4.152.0"
  },
  "dependencies": {
    "chart.js": "^4.5.1",
    "chartjs-plugin-annotation": "^3.1.0",
    "chartjs-plugin-datalabels": "^2.2.0",
    "flatpickr": "^4.6.13"
  }
}
